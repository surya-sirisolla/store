# ════════════════════════════════════════════════════════════════════════════
#  Copy this file to ".env" and fill in the values, then run: docker compose up -d
# ════════════════════════════════════════════════════════════════════════════

# Your Anthropic (Claude) API key. Get one at https://console.anthropic.com
# OPTIONAL here — you can instead add/edit/remove it later in the Owner console
# (WhatsApp page). If set here, it's the default until you change it in the UI.
ANTHROPIC_API_KEY=

# The owner's name/email shown in the console (just a label — login is gated
# separately by ADMIN_PASSWORD below).
OWNER_NAME=Owner
OWNER_EMAIL=owner@business.local

# ── Console login (required before exposing this publicly) ───────────────────
# The password used to sign in to the Owner console.
OWNER_PASSWORD=
# Signs session tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=

# ── Database (defaults are fine for a single deployment) ─────────────────────
DB_USER=storeuser
DB_PASSWORD=storepass
DB_NAME=storedb

# ── Ports (change only if these clash with something on your machine) ─────────
FRONTEND_PORT=3000          # Owner console:        http://localhost:3000
BACKEND_PORT=8080           # API:                  http://localhost:8080
PICOCLAW_PORT=18790         # PicoClaw gateway

# The URL your BROWSER uses to reach the API. If you open the console from another
# machine, change "localhost" to this server's address. Must match BACKEND_PORT.
PUBLIC_API_URL=http://localhost:8080

# Timezone for the bot's reminders/timestamps.
TZ=UTC
