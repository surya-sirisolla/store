# ════════════════════════════════════════════════════════════════════════════
#  Copy this file to ".env" and fill in the values, then run: docker compose up -d
# ════════════════════════════════════════════════════════════════════════════

# Your Anthropic (Claude) API key. Get one at https://console.anthropic.com
# OPTIONAL here — you can instead add/edit/remove it later in the Owner console
# (WhatsApp page). If set here, it's the default until you change it in the UI.
ANTHROPIC_API_KEY=

# ── Console login (REQUIRED) ─────────────────────────────────────────────────
# This deployment serves ONE business, with one admin account — set its username
# and password here, the way Grafana takes GF_SECURITY_ADMIN_USER/PASSWORD.
#
# They seed the account on the FIRST boot only: the password is hashed (bcrypt)
# into the database, after which the database is the source of truth and this
# value is ignored — rotate it later under the console's Security page. Changing
# ADMIN_USER does rename the existing account.
#
# ADMIN_PASSWORD has no default and the server REFUSES TO START without it, so a
# deployment can never come up on a well-known password. Login is rate-limited
# (10 attempts / 5 min per IP).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Signs session tokens. Optional — when blank, a secret is generated on first
# boot and saved to /shared/jwt_secret so logins survive restarts. Set it
# explicitly to pin one: openssl rand -hex 32
JWT_SECRET=

# ── HTTPS (production) ───────────────────────────────────────────────────────
# Set to your domain to turn on automatic HTTPS (Let's Encrypt) via Caddy — the
# domain's DNS A record must point at this server, and ports 80 + 443 must be
# open. Leave blank for plain HTTP on :80 (local/dev). Prod compose only.
# When set, also build the frontend with PUBLIC_API_URL=https://<that-domain>.
SITE_ADDRESS=

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# This stack has no bundled Postgres — point it at your managed database (Neon,
# RDS, or any Postgres you run yourself). Compose refuses to start without it.
#   postgresql://user:pass@host.neon.tech/db?sslmode=require
DATABASE_URL=

# ── Ports (change only if these clash with something on your machine) ─────────
FRONTEND_PORT=3000          # Owner console:        http://localhost:3000
BACKEND_PORT=8080           # API:                  http://localhost:8080
PICOCLAW_PORT=18790         # PicoClaw gateway

# The URL your BROWSER uses to reach the API (baked into the frontend at build
# time). Local: http://localhost:8080. Behind a domain with HTTPS on, set this to
# https://<your-domain> (Caddy proxies /api to the backend on the same host).
PUBLIC_API_URL=http://localhost:8080

# Timezone for the bot's reminders/timestamps.
TZ=UTC
