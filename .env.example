# ════════════════════════════════════════════════════════════════════════════
#  Copy this file to ".env" and fill in the values, then run: docker compose up -d
# ════════════════════════════════════════════════════════════════════════════

# Your Anthropic (Claude) API key. Get one at https://console.anthropic.com
# OPTIONAL here — you can instead add/edit/remove it later in the Owner console
# (WhatsApp page). If set here, it's the default until you change it in the UI.
ANTHROPIC_API_KEY=

# The owner's name/email shown in the console (just a label — login is gated
# separately by OWNER_PASSWORD below).
OWNER_NAME=Owner
OWNER_EMAIL=owner@business.local

# ── Console login (required before exposing this publicly) ───────────────────
# Seeds the console-login password on the FIRST boot: it's hashed (bcrypt) into
# the database, after which the DB is the source of truth and this value is
# ignored. Rotate the password later under the console's Security page. Login is
# rate-limited (10 attempts / 5 min per IP).
OWNER_PASSWORD=
# Signs session tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=

# ── HTTPS (production) ───────────────────────────────────────────────────────
# Set to your domain to turn on automatic HTTPS (Let's Encrypt) via Caddy — the
# domain's DNS A record must point at this server, and ports 80 + 443 must be
# open. Leave blank for plain HTTP on :80 (local/dev). Prod compose only.
# When set, also build the frontend with PUBLIC_API_URL=https://<that-domain>.
SITE_ADDRESS=

# ── Database (defaults are fine for a single deployment) ─────────────────────
DB_USER=storeuser
DB_PASSWORD=storepass
DB_NAME=storedb

# ── Ports (change only if these clash with something on your machine) ─────────
FRONTEND_PORT=3000          # Owner console:        http://localhost:3000
BACKEND_PORT=8080           # API:                  http://localhost:8080
PICOCLAW_PORT=18790         # PicoClaw gateway

# The URL your BROWSER uses to reach the API (baked into the frontend at build
# time). Local: http://localhost:8080. Behind a domain with HTTPS on, set this to
# https://<your-domain> (Caddy proxies /api to the backend on the same host).
PUBLIC_API_URL=http://localhost:8080

# Timezone for the bot's reminders/timestamps.
TZ=UTC
